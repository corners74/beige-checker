# --- AI review (recommended) ---
# Get a key at https://console.anthropic.com. Without it the app still works using rule-based checks only.
ANTHROPIC_API_KEY=
# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium        # low | medium | high  (higher = deeper review, slower, pricier)
# ANTHROPIC_FALLBACKS=0          # set to 0 to turn off automatic fallback models on refusals

# --- About you ---
# Your name, bio, services, client results and links live in content/site.json.

# --- Leads ---
# Every enquiry is saved to data/leads.jsonl. Also forward each one to a webhook
# (Zapier / Make "catch hook", Slack incoming webhook, etc.) so it lands in your inbox or CRM:
LEAD_WEBHOOK_URL=
# Read saved leads at /api/leads?key=YOUR_ADMIN_KEY
ADMIN_KEY=

# --- Limits ---
CHECKS_PER_HOUR=6                 # per visitor IP, protects your API bill
PORT=3000
